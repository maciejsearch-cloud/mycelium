{
  "name": "mycelium-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "predev": "node scripts/gen-progress.mjs",
    "dev": "vite",
    "prebuild": "node scripts/gen-progress.mjs",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "lint": "oxlint src && node scripts/check-authenticity.mjs",
